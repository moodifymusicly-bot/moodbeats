# ============================================================
# MoodBeats local/server env. Copy to `.env` and fill in values.
# This file is safe to commit; `.env` is gitignored.
# ============================================================

# --- Postgres ---
POSTGRES_USER=moodmusic
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=moodmusic

# --- Redis ---
# Used by backend cache / counters / rate limit / YouTube proxy cache.
REDIS_PASSWORD=change-me-redis-password

# --- Backend (FastAPI) ---
# Clerk -- get these from https://dashboard.clerk.com/
# Issuer looks like: https://<subdomain>.clerk.accounts.dev  (or https://clerk.<your-domain>)
# JWKS is always <issuer>/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_ISSUER=https://your-tenant.clerk.accounts.dev
CLERK_JWKS_URL=https://your-tenant.clerk.accounts.dev/.well-known/jwks.json

# YouTube Data API v3 key (server-side only, never shipped to browser).
YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXX

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Runtime knobs
ENVIRONMENT=production
CACHE_ENABLED=true
RUN_MIGRATIONS_ON_STARTUP=true

# --- Frontend (Next.js) ---
# Publicly exposed; baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
