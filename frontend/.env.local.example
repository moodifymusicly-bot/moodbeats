# Copy to `frontend/.env.local` for local `npm run dev`.
# In Docker Compose these come from the root `.env` via build args.
# Only NEXT_PUBLIC_* keys belong here -- they ship to the browser bundle.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
